aws_region = "ap-southeast-2"

name_prefix            = "app-mail-prod"
configuration_set_name = "app-mail-prod"

domain           = "mail.example.com"
mail_from_domain = "bounce.mail.example.com"

route53_zone_id          = null
create_route53_records   = false
create_domain_spf_record = true

test_from_address = "noreply@mail.example.com"
test_to_address   = "alerts@mail.example.com"

allowed_from_addresses = [
  "noreply@mail.example.com",
  "alerts@mail.example.com",
]

sns_email_subscriptions = []

tags = {
  Project = "app-mail"
}
